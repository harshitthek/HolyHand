# ==============================================================================
# HolyHand Configuration - TypeSafe Native API / Vercel AI Gateway
# ==============================================================================

# [REQUIRED] API Key: Either TypeSafe Native (apikey_...) or Vercel AI Gateway (vck_...)
# - TypeSafe Native: https://typesafe.ai (generates apikey_...)
# - Vercel AI Gateway: https://vercel.com/dashboard -> AI Gateway -> API Keys (generates vck_...)
AI_GATEWAY_API_KEY=

# [OPTIONAL] Endpoint & Model Configuration
# For TypeSafe Native: Base URL: https://api.typesafe.ai | Model: jev-latest
# For Vercel Gateway:  Base URL: https://ai-gateway.vercel.sh | Model: typesafe-ai/jev
AI_GATEWAY_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# [OPTIONAL] Privacy & Data Retention
# When true, passes providerOptions.gateway.zeroDataRetention = true (Gateway mode)
ZERO_DATA_RETENTION=false

# [OPTIONAL] Model Decision & Safety Thresholds
# Confidence threshold for action selection (0.0 to 1.0)
DECISION_CONFIDENCE_THRESHOLD=0.50
# Risk escalation threshold
RISK_CONFIDENCE_THRESHOLD=0.70

# [OPTIONAL] Execution Mode & Limits
# Set to 'false' to allow HolyHand to click and type on real windows
# Set to 'true' to simulate and print actions only
DRY_RUN=true
MAX_STEPS_PER_RUN=25

# [OPTIONAL] Test Gating
# Set to 1 to enable live integration tests that call Jev API
JEV_LIVE_TESTS=0
