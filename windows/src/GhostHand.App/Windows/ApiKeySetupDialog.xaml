<Window x:Class="HolyHand.App.Windows.ApiKeySetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyHand Setup: AI Gateway Key"
        Width="520"
        Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="HolyHand API Key Setup Dialog"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#F21E1E24"
            BorderBrush="#6366F1"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#6366F1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                    <TextBlock Text="SETUP REQUIRED" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="Connect HolyHand to Vercel AI Gateway"
                           FontSize="12"
                           Foreground="#A1A1AA"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Details Card -->
            <Border Grid.Row="1"
                    Background="#272730"
                    BorderBrush="#3D3D48"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Vercel AI Gateway API Key:"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,6" />

                    <!-- Password / Key Input Box -->
                    <Border Background="#1E1E24"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,8">
                        <PasswordBox x:Name="ApiKeyBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     FontSize="13"
                                     PasswordChar="●"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                     AutomationProperties.Name="AI Gateway API Key Password Input" />
                    </Border>

                    <!-- Hint / Instructions -->
                    <TextBlock Text="Your key will be stored securely in Windows Credential Manager."
                               Foreground="#71717A"
                               FontSize="11"
                               Margin="0,0,0,4" />

                    <TextBlock x:Name="TxtStatus"
                               Text="Press Enter or click Save to continue."
                               Foreground="#60A5FA"
                               FontSize="11"
                               Margin="0,2,0,0"
                               AutomationProperties.Name="Setup Status Message" />
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnExit"
                        Grid.Column="0"
                        Content="Exit (Esc)"
                        Height="38"
                        Background="#374151"
                        Foreground="#E4E4E7"
                        FontWeight="SemiBold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnExit_Click"
                        AutomationProperties.Name="Exit Button">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnSave"
                        Grid.Column="2"
                        Content="Save &amp; Connect (Enter)"
                        Height="38"
                        Background="#6366F1"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnSave_Click"
                        AutomationProperties.Name="Save Key Button">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
