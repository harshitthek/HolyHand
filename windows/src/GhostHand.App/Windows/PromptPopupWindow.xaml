<Window x:Class="HolyHand.App.Windows.PromptPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyHand"
        Width="580"
        Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="HolyHand Assistant Popup"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#F21E1E24"
            BorderBrush="#3D3D48"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Title & Target Info -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="HOLYHAND" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock x:Name="TargetAppText"
                               Text="Target: None"
                               FontSize="12"
                               Foreground="#A1A1AA"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="340"
                               AutomationProperties.Name="Target Application Info" />
                </StackPanel>

                <Border x:Name="ElevatedBadge"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Margin="10,0,0,0"
                        Background="#EF4444"
                        CornerRadius="4"
                        Padding="6,2"
                        Visibility="Collapsed">
                    <TextBlock Text="⚠️ ELEVATED" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>

                <!-- Close / Stop Button -->
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="✕"
                        Width="24"
                        Height="24"
                        Background="Transparent"
                        Foreground="#71717A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Close or Stop Button" />
            </Grid>

            <!-- Main Input Box -->
            <Border Grid.Row="1"
                    Background="#27272E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6">
                <Grid>
                    <TextBlock x:Name="PlaceholderText"
                               Text="What would you like HolyHand to do? (e.g., search for Adele, copy text...)"
                               Foreground="#71717A"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="2,0,0,0"/>
                    <TextBox x:Name="PromptInput"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFFFF"
                             FontSize="14"
                             VerticalAlignment="Center"
                             TextChanged="PromptInput_TextChanged"
                             AutomationProperties.Name="Task Goal Prompt Input" />
                </Grid>
            </Border>

            <!-- Footer: Status line & Action buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Press Enter to submit, Esc to cancel"
                           FontSize="11"
                           Foreground="#71717A"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Status Indicator" />

                <!-- Mic (Push-to-Talk) Button -->
                <Button x:Name="MicButton"
                        Grid.Column="1"
                        Content="🎤 Mic"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Background="#27272E"
                        Foreground="#A1A1AA"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="MicButton_Click"
                        AutomationProperties.Name="Voice Input Button" />

                <!-- Send / Submit Button -->
                <Button x:Name="SendButton"
                        Grid.Column="2"
                        Content="Send ↵"
                        Padding="14,4"
                        Background="#6366F1"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click"
                        AutomationProperties.Name="Submit Task Goal Button" />
            </Grid>
        </Grid>
    </Border>
</Window>
