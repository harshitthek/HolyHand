<Window x:Class="HolyHand.App.Windows.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyHand Safety Confirmation"
        Width="520"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="HolyHand Safety Confirmation Dialog"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#F21E1E24"
            BorderBrush="#F59E0B"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Safety Badge -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#F59E0B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                    <TextBlock Text="HUMAN APPROVAL REQUIRED" FontWeight="Bold" FontSize="11" Foreground="#1E1E24" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="A sensitive action was paused for your safety."
                           FontSize="12"
                           Foreground="#A1A1AA"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Details Card -->
            <Border Grid.Row="1"
                    Background="#272730"
                    BorderBrush="#3D3D48"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Action:" Foreground="#71717A" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtAction" Grid.Row="0" Grid.Column="1" Text="Click Button" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                               AutomationProperties.Name="Action Name" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Target:" Foreground="#71717A" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtTarget" Grid.Row="1" Grid.Column="1" Text="Submit" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                               AutomationProperties.Name="Target Element" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="App:" Foreground="#71717A" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtApp" Grid.Row="2" Grid.Column="1" Text="chrome.exe" Foreground="#D4D4D8" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                               AutomationProperties.Name="Target Application" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Reason:" Foreground="#71717A" FontSize="12"/>
                    <TextBlock x:Name="TxtReason" Grid.Row="3" Grid.Column="1" Text="Action matches sensitive verb 'Submit'" Foreground="#F87171" FontSize="12" TextWrapping="Wrap"
                               AutomationProperties.Name="Risk Reason" />
                </Grid>
            </Border>

            <!-- Actions: Reject and Approve Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnReject"
                        Grid.Column="0"
                        Content="Reject &amp; Abort (Esc)"
                        Height="38"
                        Background="#374151"
                        Foreground="#F87171"
                        FontWeight="SemiBold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnReject_Click"
                        AutomationProperties.Name="Reject Action Button">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnApprove"
                        Grid.Column="2"
                        Content="Approve &amp; Execute (Enter)"
                        Height="38"
                        Background="#10B981"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnApprove_Click"
                        AutomationProperties.Name="Approve Action Button">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
