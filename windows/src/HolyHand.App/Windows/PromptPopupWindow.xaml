<Window x:Class="HolyHand.App.Windows.PromptPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyHand"
        Width="640"
        Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown"
        AutomationProperties.Name="HolyHand Dynamic Island"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Modern Button Style with Smooth Transitions -->
        <Style x:Key="IslandPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E202E" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#2E3248" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#292C3F" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171824" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Pill Button -->
        <Style x:Key="PrimaryActionPillButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Close Button -->
        <Style x:Key="CloseIconPillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Width="20"
                                Height="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252738" />
                                <Setter Property="Foreground" Value="#F87171" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dynamic Island Pill Container -->
    <Border Background="#F40B0C11"
            BorderBrush="#252838"
            BorderThickness="1"
            CornerRadius="22"
            Padding="14,9,14,9">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header: Dynamic Island Bar (NixOS aesthetic) -->
            <Grid Grid.Row="0" Margin="4,0,4,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <!-- Glowing Indicator Dot -->
                    <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Island Logo Badge -->
                    <Border Background="#1C1E2B" BorderBrush="#2D3044" BorderThickness="1" CornerRadius="7" Padding="6,1.5" Margin="0,0,8,0">
                        <TextBlock Text="HOLYHAND" FontWeight="Bold" FontSize="9.5" Foreground="#A5B4FC" />
                    </Border>

                    <!-- Active Target App Pill -->
                    <Border Background="#141622" BorderBrush="#232536" BorderThickness="1" CornerRadius="7" Padding="7,1.5">
                        <TextBlock x:Name="TargetAppText"
                                   Text="Target: Windows Desktop"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" />
                    </Border>
                </StackPanel>

                <!-- Elevated Warning Badge -->
                <Border x:Name="ElevatedBadge"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Margin="8,0,0,0"
                        Background="#DC2626"
                        CornerRadius="7"
                        Padding="6,1.5"
                        Visibility="Collapsed">
                    <TextBlock Text="&#x26A0; ELEVATED" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>

                <!-- Close Button -->
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="&#x2715;"
                        Style="{StaticResource CloseIconPillButton}"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Close Button" />
            </Grid>

            <!-- Middle Row: Sleek Command Input Pill -->
            <Border Grid.Row="1"
                    Background="#151722"
                    BorderBrush="#292D40"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,4"
                    Margin="0,0,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Command Prompt Glyph -->
                    <TextBlock Grid.Column="0"
                               Text="&#x2726;"
                               FontSize="12"
                               Foreground="#818CF8"
                               VerticalAlignment="Center"
                               Margin="2,0,8,0" />

                    <!-- Input Box & Placeholder -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderText"
                                   Text="What would you like HolyHand to do?"
                                   Foreground="#525866"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Margin="2,0,0,0"/>
                        <TextBox x:Name="PromptInput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F8FAFC"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 CaretBrush="#818CF8"
                                 TextChanged="PromptInput_TextChanged"
                                 AutomationProperties.Name="Task Goal Prompt Input" />
                    </Grid>

                    <!-- Mic Button -->
                    <Button x:Name="MicButton"
                            Grid.Column="2"
                            Content="&#x1F3A4; Mic"
                            Style="{StaticResource IslandPillButton}"
                            Margin="6,0,6,0"
                            Click="MicButton_Click"
                            AutomationProperties.Name="Voice Input Button" />

                    <!-- Send Button -->
                    <Button x:Name="SendButton"
                            Grid.Column="3"
                            Content="Run &#x21B5;"
                            Style="{StaticResource PrimaryActionPillButton}"
                            Click="SendButton_Click"
                            AutomationProperties.Name="Submit Task Goal Button" />
                </Grid>
            </Border>

            <!-- Bottom Row: Dynamic Status / Micro-Feedback Line -->
            <Grid Grid.Row="2" Margin="6,0,6,0">
                <TextBlock x:Name="StatusText"
                           Text="Press Enter to submit, Esc to cancel"
                           FontSize="10"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Status Indicator" />
            </Grid>
        </Grid>
    </Border>
</Window>
