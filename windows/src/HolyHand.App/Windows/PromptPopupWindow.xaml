<Window x:Class="HolyHand.App.Windows.PromptPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyHand Dynamic Island"
        Width="640"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="HolyHand Dynamic Island"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Modern Button Style with Smooth Transitions -->
        <Style x:Key="IslandPillButton" TargetType="Button">
            <Setter Property="Background" Value="#222538" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#383D5C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D324D" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171926" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Pill Button -->
        <Style x:Key="PrimaryActionPillButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Header Icon Button -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Width="24"
                                Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252A40" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. COLLAPSED DYNAMIC ISLAND (High contrast idle top pill) -->
        <Border x:Name="CollapsedIsland"
                Visibility="Collapsed"
                Background="#F2131626"
                BorderBrush="#6366F1"
                BorderThickness="1.5"
                CornerRadius="19"
                Height="38"
                Padding="12,0,12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Cursor="Hand"
                MouseDown="CollapsedIsland_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#4F46E5" BlurRadius="18" ShadowDepth="2" Opacity="0.55" />
            </Border.Effect>

            <Border.ContextMenu>
                <ContextMenu Background="#141624" Foreground="#E2E8F0" BorderBrush="#383D5C">
                    <MenuItem Header="Expand Island (Alt+Space)" Click="MenuExpand_Click" />
                    <MenuItem Header="Re-center Island" Click="MenuRecenter_Click" />
                    <Separator Background="#282C40" />
                    <MenuItem Header="Hide to Background" Click="MenuHide_Click" />
                    <MenuItem Header="Exit HolyHand" Click="MenuExit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Glowing Indicator Dot -->
                <Ellipse x:Name="CollapsedDot"
                         Grid.Column="0"
                         Width="8"
                         Height="8"
                         Fill="#10B981"
                         Margin="2,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Brand Badge -->
                <TextBlock Grid.Column="1"
                           Text="HOLYHAND"
                           FontWeight="Bold"
                           FontSize="10.5"
                           Foreground="#F8FAFC"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <!-- Sparkle -->
                <TextBlock Grid.Column="2"
                           Text="✦"
                           FontSize="10"
                           Foreground="#A5B4FC"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Shortcut / Status Chip -->
                <Border Grid.Column="3"
                        Background="#202438"
                        BorderBrush="#3B4263"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="7,2">
                    <TextBlock x:Name="CollapsedStatusPillText"
                               Text="Alt+Space"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="#C7D2FE"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. EXPANDED DYNAMIC ISLAND (Command Center) -->
        <Border x:Name="ExpandedIsland"
                Visibility="Visible"
                Background="#F60F111E"
                BorderBrush="#6366F1"
                BorderThickness="1.5"
                CornerRadius="22"
                Padding="16,10,16,10"
                MouseDown="ExpandedIsland_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.75" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header: Dynamic Island Bar (NixOS aesthetic) -->
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <!-- Glowing Indicator Dot -->
                        <Ellipse x:Name="ExpandedDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Island Logo Badge -->
                        <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="7" Padding="7,2" Margin="0,0,8,0">
                            <TextBlock Text="HOLYHAND" FontWeight="Bold" FontSize="10" Foreground="#C7D2FE" />
                        </Border>

                        <!-- Active Target App Pill -->
                        <Border Background="#181B2B" BorderBrush="#2C314C" BorderThickness="1" CornerRadius="7" Padding="8,2">
                            <TextBlock x:Name="TargetAppText"
                                       Text="Target: Windows Desktop"
                                       FontSize="11"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="310" />
                        </Border>
                    </StackPanel>

                    <!-- Elevated Warning Badge -->
                    <Border x:Name="ElevatedBadge"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,0"
                            Background="#DC2626"
                            CornerRadius="7"
                            Padding="6,2"
                            Visibility="Collapsed">
                        <TextBlock Text="⚠ ELEVATED" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>

                    <!-- Header Controls: Collapse & Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="CollapseButton"
                                Content="—"
                                ToolTip="Collapse to Island Pill (Esc)"
                                Style="{StaticResource HeaderIconButton}"
                                Margin="0,0,4,0"
                                Click="CollapseButton_Click"
                                AutomationProperties.Name="Collapse Button" />
                        <Button x:Name="CloseButton"
                                Content="✕"
                                ToolTip="Collapse to Island Pill"
                                Style="{StaticResource HeaderIconButton}"
                                Click="CloseButton_Click"
                                AutomationProperties.Name="Close Button" />
                    </StackPanel>
                </Grid>

                <!-- Middle Row: Sleek Command Input Pill -->
                <Border Grid.Row="1"
                        Background="#161928"
                        BorderBrush="#2F3552"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,5"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Command Prompt Glyph -->
                        <TextBlock Grid.Column="0"
                                   Text="✦"
                                   FontSize="13"
                                   Foreground="#818CF8"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0" />

                        <!-- Input Box & Placeholder -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaceholderText"
                                       Text="What would you like HolyHand to do?"
                                       Foreground="#64748B"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0"/>
                            <TextBox x:Name="PromptInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F8FAFC"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     CaretBrush="#818CF8"
                                     TextChanged="PromptInput_TextChanged"
                                     AutomationProperties.Name="Task Goal Prompt Input" />
                        </Grid>

                        <!-- Mic Button -->
                        <Button x:Name="MicButton"
                                Grid.Column="2"
                                Content="🎤 Mic"
                                Style="{StaticResource IslandPillButton}"
                                Margin="6,0,6,0"
                                Click="MicButton_Click"
                                AutomationProperties.Name="Voice Input Button" />

                        <!-- Send Button -->
                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                Content="Run ↵"
                                Style="{StaticResource PrimaryActionPillButton}"
                                Click="SendButton_Click"
                                AutomationProperties.Name="Submit Task Goal Button" />
                    </Grid>
                </Border>

                <!-- Bottom Row: Dynamic Status / Micro-Feedback Line -->
                <Grid Grid.Row="2" Margin="6,0,6,0">
                    <TextBlock x:Name="StatusText"
                               Text="Ready • Enter ↵ to run • Esc to collapse • Alt+Space to toggle"
                               FontSize="10.5"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Status Indicator" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
